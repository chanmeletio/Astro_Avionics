# ==========================================
# Astro at Baylor - Avionics Repository .gitignore
# ==========================================

# --- KiCad EDA Artifacts ---
*.kicad_prl
*.kicad_pcb-bak
*.kicad_sch-bak
*-save.kicad_pcb
*-save.kicad_sch
*-bak
*.bak
_autosave-*
*.lck
*.tmp
fp-info-cache
*.net
*.drc
*.csv.bak

# Exclude generated manufacturing artifacts from git root if built locally (tagged releases tracked via LFS or CI)
hardware/**/manufacturing/gerbers/*.zip
hardware/**/manufacturing/assembly/*.zip

# --- Build Systems & Compilers (CMake / GCC / Clang) ---
build/
bin/
out/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.ninja
.ninja_*
*.o
*.obj
*.d
*.elf
*.hex
*.bin
*.map
*.a
*.lib
*.so
*.dylib
*.dll

# --- STM32 / IDEs (STM32CubeIDE, Keil, IAR, VS Code, CLion) ---
.project
.cproject
.settings/
*.launch
.metadata/
*.uvprojx
*.uvoptx
*.ewp
*.eww
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/

# --- Python / Sim / Ground Station ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
*.log

# --- Node / Ground Station Web Dashboard ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
dist/

# --- Operating System & Temporary Files ---
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.swp
*~
*.orig
